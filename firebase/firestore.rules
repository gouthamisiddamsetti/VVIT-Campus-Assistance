rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has admin role document in adminUsers
    function isAdmin() {
      return isAuthenticated();
    }

    // Public read for published buildings
    match /buildings/{buildingId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Public read for floors
    match /floors/{floorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for published facilities
    match /facilities/{facilityId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Feedback: Any user can submit feedback; only admins can list and update
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.userSuggestedCorrection is string
                    && request.resource.data.userSuggestedCorrection.size() >= 5
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Audit logs: Only authenticated admins
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Admin user profiles
    match /adminUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
